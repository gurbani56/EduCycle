# EduCycle configuration — copy this file to `.env` (same folder) and fill in your own values.
# Never commit your real .env file.

# development | production
NODE_ENV=development
PORT=3000

# Local MongoDB:            mongodb://127.0.0.1:27017/educycle
MONGODB_URI=mongodb://127.0.0.1:27017/educycle

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# How long a login stays valid without activity (hours)
SESSION_MAX_AGE_HOURS=72

# --- First administrator (read by `npm run create-admin`) ---
# You can also leave these empty and the script will prompt you.
# Remove the password from this file after the admin account has been created.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional: lets the imported demo students sign in (read by `npm run migrate`) ---
# Must be 8+ characters with letters and numbers. Leave empty to disable demo logins.
DEMO_USER_PASSWORD=
